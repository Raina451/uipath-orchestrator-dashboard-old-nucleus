# UiPath Orchestrator Configuration
# Copy this file to .env and fill in your actual values
# UiPath Cloud Organization Name (e.g., myorganization)
VITE_UIPATH_ORG_NAME=your_org_name
# UiPath Tenant Name (e.g., DefaultTenant)
VITE_UIPATH_TENANT_NAME=your_tenant_name
# OAuth Client ID from UiPath Cloud (External Application)
VITE_UIPATH_CLIENT_ID=your_client_id
# UiPath Cloud Base URL (usually https://cloud.uipath.com)
VITE_UIPATH_BASE_URL=https://cloud.uipath.com
# OAuth Scopes (space-separated, e.g., OR.Execution OR.Folders OR.Jobs)
VITE_UIPATH_SCOPE=OR.Execution OR.Folders OR.Jobs OR.Queues OR.Assets OR.Robots